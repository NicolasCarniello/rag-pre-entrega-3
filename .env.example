# Copiá este archivo a .env y completá tu clave. El .env NO se sube a Git.

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Proveedores (valores por defecto):
# LLM_PROVIDER=gemini             # gemini | openai | anthropic | ollama
# LLM_MODEL=gemini-flash-latest   # alias que apunta al Flash más reciente
# EMBEDDING_PROVIDER=gemini       # gemini | openai | huggingface (local)
# EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_API_KEY=                 # solo si usás openai
# ANTHROPIC_API_KEY=              # solo si usás anthropic

# Parámetros RAG
# TOP_K=4
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
